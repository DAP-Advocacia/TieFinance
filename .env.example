# Postgres (Supabase). Em Vercel use o Transaction pooler (porta 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Admin inicial: criado no primeiro login se a tabela users estiver vazia (senha com 12+ caracteres)
ERP_ADMIN_EMAIL=admin@exemplo.com
ERP_ADMIN_PASSWORD=
# Opcional
RECONCILE_TOLERANCE_DAYS=3
